<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="x2_ultra">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="ros2_control_gains_file" default="x2_ros2_control_gains.yaml" />
    <xacro:arg name="use_fake_hardware" default="true" />
    <xacro:arg name="command_transport" default="ros_topic" />
    <xacro:arg name="zmq_endpoint" default="tcp://*:8559" />
    <xacro:arg name="leg_state_topic" default="/aima/hal/joint/leg/state" />
    <xacro:arg name="waist_state_topic" default="/aima/hal/joint/waist/state" />
    <xacro:arg name="arm_state_topic" default="/aima/hal/joint/arm/state" />
    <xacro:arg name="head_state_topic" default="/aima/hal/joint/head/state" />
    <xacro:arg name="left_hand_pad_origin" default="0 0 -0.13" />
    <xacro:arg name="right_hand_pad_origin" default="0 0 -0.13" />
    <xacro:property name="hand_pad_thickness" value="0.012" />
    <xacro:property name="hand_pad_width" value="0.08" />
    <xacro:property name="hand_pad_height" value="0.10" />

    <!-- Import x2_ultra urdf file -->
    <xacro:include filename="$(find x2_description)/urdf/x2_ultra.urdf" />

    <!-- Passive pads: left TCP -Y and right TCP +Y pass through the contact surface. -->
    <xacro:macro name="x2_hand_pad" params="side origin tcp_y">
      <link name="${side}_hand_pad_link">
        <visual>
          <geometry><box size="${hand_pad_width} ${hand_pad_thickness} ${hand_pad_height}"/></geometry>
          <material name="x2_contact_pad"><color rgba="0.15 0.15 0.15 1"/></material>
        </visual>
        <collision><geometry><box size="${hand_pad_width} ${hand_pad_thickness} ${hand_pad_height}"/></geometry></collision>
        <inertial>
          <mass value="0.05"/><origin xyz="0 0 0"/>
          <inertia ixx="0.0000417" ixy="0" ixz="0" iyy="0.0000417" iyz="0" izz="0.0000417"/>
        </inertial>
      </link>
      <joint name="${side}_hand_pad_joint" type="fixed">
        <parent link="${side}_wrist_roll_link"/><child link="${side}_hand_pad_link"/>
        <origin xyz="${origin}" rpy="0 0 0"/>
      </joint>
      <link name="${side}_hand_tcp_link"/>
      <joint name="${side}_hand_tcp_joint" type="fixed">
        <parent link="${side}_hand_pad_link"/><child link="${side}_hand_tcp_link"/>
        <origin xyz="0 ${tcp_y} 0" rpy="0 0 0"/>
      </joint>
    </xacro:macro>

    <xacro:x2_hand_pad side="left" origin="$(arg left_hand_pad_origin)" tcp_y="${-hand_pad_thickness / 2.0}"/>
    <xacro:x2_hand_pad side="right" origin="$(arg right_hand_pad_origin)" tcp_y="${hand_pad_thickness / 2.0}"/>

    <!-- Import control_xacro -->
    <xacro:include filename="x2_ultra.ros2_control.xacro" />


    <xacro:x2_ultra_ros2_control
        name="X2System"
        initial_positions_file="$(arg initial_positions_file)"
        gains_file="$(arg ros2_control_gains_file)"
        use_fake_hardware="$(arg use_fake_hardware)"
        command_transport="$(arg command_transport)"
        zmq_endpoint="$(arg zmq_endpoint)"
        leg_state_topic="$(arg leg_state_topic)"
        waist_state_topic="$(arg waist_state_topic)"
        arm_state_topic="$(arg arm_state_topic)"
        head_state_topic="$(arg head_state_topic)"/>

</robot>
